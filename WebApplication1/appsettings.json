{
  "ConnectionStrings": {
    "DefaultConnection": "Server=PRADEEP\\SQLEXPRESS;Database=AuthSystemDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "App": { "PublicBaseUrl": "" },
  "KeyVault": { "Uri": "" },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "Password": "",
    "FromName": "AuthSystem",
    "FromAddress": ""
  },
  "EmailOutbox": {
    "MaxAttempts": 5,
    "BatchSize": 20,
    "PollSeconds": 10,
    "BaseDelaySeconds": 30,
    "RetainSentDays": 7
  },
  "SeedAdmin": {
    "Email": "admin@example.com",
    "Password": ""
  },
  "AllowedHosts": "localhost"
}
